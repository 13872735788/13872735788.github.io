<html lang="zh-CN"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>探索反比例的意义</title>
    <script src="https://data.zcat.cn/cdn/npm/@tailwindcss/3.4.17.js"></script>
    <link rel="stylesheet" href="https://data.zcat.cn/cdn/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://api.zcat.cn/udata/711819/css/3e6a9b79b449113b44a6ebc771bb41e4.css');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #e8f4f8 0%, #f0f7f4 50%, #fff9e6 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        .card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        }
        
        .water {
            background: linear-gradient(180deg, #60a5fa 0%, #3b82f6 50%, #2563eb 100%);
            position: relative;
            overflow: hidden;
        }
        
        .water::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 8px;
            background: linear-gradient(180deg, rgba(255,255,255,0.6) 0%, rgba(96,165,250,0.3) 100%);
            border-radius: 50%;
            animation: wave 2s ease-in-out infinite;
        }
        
        @keyframes wave {
            0%, 100% { transform: scaleY(1); }
            50% { transform: scaleY(0.7); }
        }
        
        .cylinder {
            border: 3px solid #64748b;
            background: rgba(255,255,255,0.9);
            position: relative;
        }
        
        .cylinder::before {
            content: '';
            position: absolute;
            top: -8px;
            left: -3px;
            right: -3px;
            height: 12px;
            background: #e2e8f0;
            border: 3px solid #64748b;
            border-radius: 50%;
        }
        
        .slider-track {
            background: linear-gradient(90deg, #93c5fd, #3b82f6);
            height: 12px;
            border-radius: 6px;
        }
        
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 12px;
            background: #e2e8f0;
            border-radius: 6px;
            outline: none;
            cursor: pointer;
        }
        
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 28px;
            height: 28px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(59,130,246,0.4);
            border: 3px solid white;
            transition: transform 0.2s;
        }
        
        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(59,130,246,0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(59,130,246,0.4);
        }
        
        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(16,185,129,0.3);
        }
        
        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16,185,129,0.4);
        }
        
        .btn-warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(245,158,11,0.3);
        }
        
        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(245,158,11,0.4);
        }
        
        .btn-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(239,68,68,0.3);
        }
        
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(239,68,68,0.4);
        }
        
        .data-row {
            transition: all 0.3s;
        }
        
        .data-row:hover {
            background: #f0f9ff;
            transform: scale(1.02);
        }
        
        .highlight-text {
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        
        .tube-water {
            animation: flowWater 0.8s ease-in-out;
        }
        
        @keyframes flowWater {
            0% { opacity: 0; transform: scaleY(0); }
            100% { opacity: 1; transform: scaleY(1); }
        }
        
        .table-container {
            max-height: 300px;
            overflow-y: auto;
        }
        
        .table-container::-webkit-scrollbar {
            width: 8px;
        }
        
        .table-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        
        .table-container::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 4px;
        }
        
        .coordinate-canvas {
            border: 2px solid #cbd5e1;
            background: white;
            border-radius: 12px;
        }
        
        .point-marker {
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .point-marker:hover {
            transform: scale(1.3);
        }
        
        /* 新增：容器变宽动画效果 */
        .container-resizing {
            transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
        }
    </style>
</head>
<body class="p-4 lg:p-6">
    <!-- 主标题 -->
    <div class="text-center mb-6">
        <h1 class="text-3xl lg:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600 mb-2">
            <i class="fas fa-flask mr-2"></i>探索反比例的意义
        </h1>
        <p class="text-gray-600 text-lg">当圆柱形</p>
    </div>

    <!-- 主要内容区域 -->
    <div class="max-w-7xl mx-auto">
        <!-- 顶部说明 -->
        <div class="card p-4 mb-4 bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500">
            <div class="flex items-center gap-3">
                <i class="fas fa-info-circle text-blue-500 text-2xl"></i>
                <div class="">
                    <p class="font-semibold text-blue-800">实验原理</p>
                    <p class="text-blue-600">体积 = 底面积 × 高。当体积固定为 1000 cm³ 时，底面积越大，高度越小，它们成反比例关系。</p>
                </div>
            </div>
        </div>

        <!-- 实验装置区域 -->
        <div class="card p-6 mb-4">
            <h2 class="text-xl font-bold text-gray-700 mb-4 flex items-center gap-2">
                <i class="fas fa-vial text-blue-500"></i> 实验装置
            </h2>
            
            <div class="flex flex-col lg:flex-row items-center justify-center gap-8">
                <!-- 左侧容器 -->
                <div class="text-center">
                    <div class="relative" style="width: 140px; height: 100px;">
                        <div id="leftCylinder" class="cylinder w-full h-full rounded-b-3xl relative">
                            <div id="leftWater" class="water absolute bottom-0 left-0 right-0 rounded-b-lg transition-all duration-500" style="height: 100%;">
                            </div>
                        </div>
                        <!-- 刻度线 -->
                        <div class="absolute left-full top-0 h-full flex flex-col justify-between text-xs text-gray-500 pl-2">
                            <span class="">10cm</span>
                            <span class="">5cm</span>
                            <span class="">0cm</span>
                        </div>
                    </div>
                    <div class="mt-4 bg-blue-100 rounded-lg p-3">
                        <p class="font-bold text-blue-800 text-lg">左侧容器</p>
                        <p class="text-blue-600">体积：<span class="font-bold">1000 cm³</span></p>
                        <p class="text-blue-600">底面积：<span class="font-bold">100 cm²</span></p>
                        <p class="text-blue-600">高度：<span class="font-bold">10 cm</span></p>
                    </div>
                </div>

                <!-- 导管 -->
                <div class="flex flex-col items-center">
                    <div class="relative" style="width: 120px; height: 80px;">
                        <!-- 上导管 -->
                        <div class="absolute top-0 left-1/2 transform -translate-x-1/2">
                            <div class="w-8 h-20 bg-gradient-to-b from-blue-300 to-blue-400 rounded-lg border-2 border-blue-500 relative">
                                <div id="tubeWater" class="water absolute top-0 left-0 right-0 rounded-t-lg opacity-0 transition-all duration-1000" style="height: 100%;"></div>
                            </div>
                        </div>
                        <!-- 箭头 -->
                        <div class="absolute top-8 left-1/2 transform -translate-x-1/2 text-blue-500 text-3xl animate-bounce">
                            <i class="fas fa-arrow-down"></i>
                        </div>
                    </div>
                    
                    <!-- 操作按钮 -->
                    <button id="pourBtn" class="btn-primary mt-4 flex items-center gap-2" onclick="pourWater()">
                        <i class="fas fa-tint"></i> 注水
                    </button>
                    <button id="resetBtn" class="btn-warning mt-2 flex items-center gap-2" onclick="resetExperiment()">
                        <i class="fas fa-redo"></i> 重置
                    </button>
                </div>

                <!-- 右侧容器 -->
                <div class="text-center">
                    <div class="relative flex items-end justify-center" style="height: 400px; width: 100%; max-width: 400px;">
                        <!-- 容器主体，宽度动态变化 -->
                        <div id="rightCylinderContainer" class="relative container-resizing mx-auto" style="width: 70px; height: 400px;">
                            <div id="rightCylinder" class="cylinder w-full h-full rounded-b-3xl relative">
                                <div id="rightWater" class="water absolute bottom-0 left-0 right-0 rounded-b-lg transition-all duration-1000" style="height: 0%;">
                                </div>
                            </div>
                        </div>
                        <!-- 刻度线 (固定在右侧) -->
                        <div class="absolute right-[-60px] top-0 h-full flex flex-col justify-between text-xs text-gray-500 pl-2 border-l border-gray-300">
                            <span class="">40cm</span>
                            <span class="">20cm</span>
                            <span class="">0cm</span>
                        </div>
                    </div>
                    <div class="mt-4 bg-green-100 rounded-lg p-3">
                        <p class="font-bold text-green-800 text-lg">右侧容器</p>
                        <p class="text-green-600">底面积：<span id="displayArea" class="font-bold">25 cm²</span></p>
                        <p class="text-green-600">高度：<span id="displayHeight" class="font-bold">40.00 cm</span></p>
                    </div>
                </div>
            </div>

            <!-- 滑块控制区 -->
            <div class="mt-6 bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-lg font-bold text-gray-700">
                        <i class="fas fa-sliders-h text-purple-500 mr-2"></i>调整右侧容器底面积
                    </span>
                    <span class="text-2xl font-bold text-purple-600" id="sliderValue">25 cm²</span>
                </div>
                
                <input type="range" id="areaSlider" min="25" max="300" step="25" value="25" class="w-full" oninput="updateSliderValue()" ontouchmove="updateSliderValue()">
                
                <div class="flex justify-between text-sm text-gray-500 mt-2">
                    <span class="">25 cm²</span>
                    <span class="">50</span>
                    <span class="">100</span>
                    <span class="">150</span>
                    <span class="">200</span>
                    <span class="">250</span>
                    <span class="">300 cm²</span>
                </div>
            </div>
        </div>

        <!-- 数据展示和图像区域 -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <!-- 数据记录区 -->
            <div class="card p-6">
                <h2 class="text-xl font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-table text-green-500"></i> 数据记录
                </h2>

                <!-- 当前数据 -->
                <div class="bg-gradient-to-r from-yellow-50 to-orange-50 rounded-xl p-4 mb-4 border-2 border-yellow-300">
                    <h3 class="font-bold text-yellow-800 mb-2">
                        <i class="fas fa-star text-yellow-500 mr-1"></i>当前数据
                    </h3>
                    <div class="grid grid-cols-3 gap-4 text-center">
                        <div class="bg-white rounded-lg p-3 shadow">
                            <p class="text-gray-500 text-sm">底面积 S (cm²)</p>
                            <p class="text-2xl font-bold text-blue-600" id="currentArea">25</p>
                        </div>
                        <div class="bg-white rounded-lg p-3 shadow">
                            <p class="text-gray-500 text-sm">高度 h (cm)</p>
                            <p class="text-2xl font-bold text-green-600" id="currentHeight">40.00</p>
                        </div>
                        <div class="bg-white rounded-lg p-3 shadow border-2 border-yellow-400">
                            <p class="text-gray-500 text-sm">乘积 S × h</p>
                            <p class="text-2xl font-bold text-orange-600 highlight-text" id="currentProduct">1000</p>
                        </div>
                    </div>
                </div>

                <!-- 历史记录 -->
                <div class="mb-4">
                    <h3 class="font-bold text-gray-700 mb-2 flex items-center gap-2">
                        <i class="fas fa-history text-gray-500"></i>历史记录
                    </h3>
                    <div class="table-container bg-gray-50 rounded-lg">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-200 sticky top-0">
                                <tr>
                                    <th class="py-2 px-3 text-center">序号</th>
                                    <th class="py-2 px-3 text-center">底面积 S (cm²)</th>
                                    <th class="py-2 px-3 text-center">高度 h (cm)</th>
                                    <th class="py-2 px-3 text-center">乘积</th>
                                    <th class="py-2 px-3 text-center">操作</th>
                                </tr>
                            </thead>
                            <tbody id="dataTable">
                                <!-- 数据行将动态添加 -->
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-2 text-right text-gray-500 text-sm">
                        共记录 <span id="recordCount" class="font-bold text-blue-600">0</span> 条数据
                    </div>
                </div>

                <!-- 操作按钮 -->
                <div class="flex flex-wrap gap-2">
                    <button id="recordBtn" class="btn-success flex items-center gap-2" onclick="recordData()" disabled="">
                        <i class="fas fa-save"></i> 记录数据
                    </button>
                    <button id="clearBtn" class="btn-danger flex items-center gap-2" onclick="clearRecords()" disabled="">
                        <i class="fas fa-trash"></i> 清空记录
                    </button>
                    <button id="generateBtn" class="btn-primary flex items-center gap-2" onclick="generateChart()" disabled="">
                        <i class="fas fa-chart-line"></i> 生成图像
                    </button>
                    <button id="drawLineBtn" class="btn-warning flex items-center gap-2" onclick="drawLine()" disabled="">
                        <i class="fas fa-edit"></i> 连线
                    </button>
                    <button id="clearChartBtn" class="bg-gray-500 text-white px-4 py-2 rounded-lg flex items-center gap-2" onclick="clearChart()" disabled="">
                        <i class="fas fa-eraser"></i> 清空图像
                    </button>
                </div>
            </div>

            <!-- 坐标系区域 -->
            <div class="card p-6">
                <h2 class="text-xl font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-chart-scattertext-red-500"></i> 反比例图像
                </h2>
                
                <div class="bg-gray-50 rounded-xl p-4">
                    <canvas id="coordCanvas" class="coordinate-canvas w-full" style="height: 400px;"></canvas>
                </div>
                
                <div class="mt-4 bg-blue-50 rounded-lg p-4">
                    <h3 class="font-bold text-blue-800 mb-2">
                        <i class="fas fa-lightbulb text-yellow-500 mr-1"></i>发现规律
                    </h3>
                    <p class="text-blue-700" id="discoveryText">
                        请先调整底面积，点击"注水"，然后记录数据，生成图像后观察规律！
                    </p>
                </div>
            </div>
        </div>

        <!-- 结论区域 -->
        <div class="card p-6 mt-4 bg-gradient-to-r from-indigo-50 to-purple-50 border-2 border-indigo-300">
            <h2 class="text-xl font-bold text-indigo-800 mb-4 flex items-center gap-2">
                <i class="fas fa-graduation-cap text-indigo-500"></i> 总结与结论
            </h2>
            <div class="bg-white rounded-xl p-6 shadow-inner">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="text-center p-4 bg-blue-50 rounded-lg">
                        <div class="text-4xl mb-2">📊</div>
                        <p class="font-bold text-blue-800 text-lg">数据验证</p>
                        <p class="text-blue-600 mt-2">每组数据的底面积 × 高度 = <span class="font-bold text-xl text-blue-800">1000</span></p>
                    </div>
                    <div class="text-center p-4 bg-green-50 rounded-lg">
                        <div class="text-4xl mb-2">📈</div>
                        <p class="font-bold text-green-800 text-lg">图像特征</p>
                        <p class="text-green-600 mt-2">反比例图像是<span class="font-bold">光滑曲线</span>，越接近坐标轴，数值越大</p>
                    </div>
                    <div class="text-center p-4 bg-purple-50 rounded-lg">
                        <div class="text-4xl mb-2">📐</div>
                        <p class="font-bold text-purple-800 text-lg">数学表达</p>
                        <p class="text-purple-600 mt-2">若 S × h = k（常数），则 <span class="font-bold text-xl text-purple-800">h = k/S</span></p>
                    </div>
                </div>
                <div class="mt-6 text-center bg-gradient-to-r from-yellow-100 to-orange-100 rounded-lg p-4">
                    <p class="text-xl font-bold text-orange-800">
                        <i class="fas fa-check-circle text-green-500 mr-2"></i>
                        结论：当圆柱形容器的体积一定时，底面积和高度成<span class="text-red-600">反比例</span>关系！
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 全局变量
        let currentArea = 25;
        let currentHeight = 40;
        let dataRecords = [];
        let hasPoured = false;
        let chartGenerated = false;
        let lineDrawn = false;

        // DOM元素
        const areaSlider = document.getElementById('areaSlider');
        const sliderValue = document.getElementById('sliderValue');
        const displayArea = document.getElementById('displayArea');
        const displayHeight = document.getElementById('displayHeight');
        const currentAreaEl = document.getElementById('currentArea');
        const currentHeightEl = document.getElementById('currentHeight');
        const currentProductEl = document.getElementById('currentProduct');
        const leftWater = document.getElementById('leftWater');
        const rightWater = document.getElementById('rightWater');
        const tubeWater = document.getElementById('tubeWater');
        const dataTable = document.getElementById('dataTable');
        const recordCount = document.getElementById('recordCount');
        const pourBtn = document.getElementById('pourBtn');
        const recordBtn = document.getElementById('recordBtn');
        const clearBtn = document.getElementById('clearBtn');
        const generateBtn = document.getElementById('generateBtn');
        const drawLineBtn = document.getElementById('drawLineBtn');
        const clearChartBtn = document.getElementById('clearChartBtn');
        const discoveryText = document.getElementById('discoveryText');
        const coordCanvas = document.getElementById('coordCanvas');

        // 初始化
        function init() {
            setupCanvas();
            updateDisplay();
            // 监听窗口大小变化
            window.addEventListener('resize', () => {
                setupCanvas();
                if (chartGenerated) generateChart();
            });
        }

        // 设置Canvas尺寸
        function setupCanvas() {
            const container = coordCanvas.parentElement;
            const width = container.clientWidth - 32;
            coordCanvas.width = width;
            coordCanvas.height = 400;
        }

        // 更新滑块数值显示
        function updateSliderValue() {
            currentArea = parseInt(areaSlider.value);
            sliderValue.textContent = currentArea + ' cm²';
            
            // 立即更新容器宽度（即使未注水）
            const minVisualWidth = 70;   // 对应25cm²
            const maxVisualWidth = 280;  // 对应300cm²
            const visualWidth = minVisualWidth + ((currentArea - 25) / (300 - 25)) * (maxVisualWidth - minVisualWidth);
            
            const cylinderContainer = document.getElementById('rightCylinderContainer');
            if (cylinderContainer) {
                // 添加平滑过渡效果
                cylinderContainer.classList.add('container-resizing');
                cylinderContainer.style.width = visualWidth + 'px';
            }
            
            // 更新其他显示内容
            updateDisplay();
        }

        // 更新显示内容
        function updateDisplay() {
            currentHeight = (1000 / currentArea).toFixed(2);
            
            displayArea.textContent = currentArea + ' cm²';
            displayHeight.textContent = currentHeight + ' cm';
            currentAreaEl.textContent = currentArea;
            currentHeightEl.textContent = currentHeight;
            currentProductEl.textContent = '1000';
        }

        // 注水动画
        function pourWater() {
            if (hasPoured) {
                resetExperiment();
            }
            
            // 显示导管水流
            tubeWater.style.opacity = '1';
            
            // 左侧水位下降
            setTimeout(() => {
                leftWater.style.height = '0%';
            }, 200);
            
            // 右侧水位上升
            setTimeout(() => {
                // 容器视觉高度对应 40cm，所以直接除以 40 计算百分比
                const heightPercent = (parseFloat(currentHeight) / 40) * 100;
                rightWater.style.height = Math.min(heightPercent, 100) + '%';
                tubeWater.style.opacity = '0';
            }, 800);
            
            hasPoured = true;
            pourBtn.innerHTML = '<i class="fas fa-undo"></i> 重置';
            recordBtn.disabled = false;
            
            // 更新发现文本
            discoveryText.innerHTML = `已注入 1000 cm³ 水，右侧容器水面高度为 <span class="font-bold text-green-600">${currentHeight} cm</span>！点击"记录数据"保存这组数据。`;
        }

        // 重置实验
        function resetExperiment() {
            leftWater.style.height = '100%';
            rightWater.style.height = '0%';
            tubeWater.style.opacity = '0';
            
            hasPoured = false;
            pourBtn.innerHTML = '<i class="fas fa-tint"></i> 注水';
            
            discoveryText.textContent = '请先调整底面积，点击"注水"，然后记录数据，生成图像后观察规律！';
        }

        // 记录数据
        function recordData() {
            if (!hasPoured) {
                alert('请先点击"注水"再记录数据！');
                return;
            }
            
            const record = {
                area: currentArea,
                height: currentHeight
            };
            
            // 检查是否已存在相同的底面积记录
            const existingIndex = dataRecords.findIndex(r => r.area === currentArea);
            if (existingIndex !== -1) {
                dataRecords[existingIndex] = record;
            } else {
                dataRecords.push(record);
            }
            
            // 按底面积排序
            dataRecords.sort((a, b) => a.area - b.area);
            
            updateTable();
            
            clearBtn.disabled = false;
            if (dataRecords.length >= 2) {
                generateBtn.disabled = false;
            }
            
            discoveryText.innerHTML = `已记录第 <span class="font-bold text-blue-600">${dataRecords.length}</span> 组数据！底面积 = ${currentArea} cm²，高度 = ${currentHeight} cm。`;
        }

        // 更新数据表格
        function updateTable() {
            dataTable.innerHTML = '';
            
            dataRecords.forEach((record, index) => {
                const row = document.createElement('tr');
                row.className = 'data-row border-b border-gray-200';
                row.innerHTML = `
                    <td class="py-2 px-3 text-center font-bold text-blue-600">${index + 1}</td>
                    <td class="py-2 px-3 text-center">${record.area}</td>
                    <td class="py-2 px-3 text-center">${record.height}</td>
                    <td class="py-2 px-3 text-center font-bold text-orange-600">1000</td>
                    <td class="py-2 px-3 text-center">
                        <button onclick="deleteRecord(${index})" class="text-red-500 hover:text-red-700">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                `;
                dataTable.appendChild(row);
            });
            
            recordCount.textContent = dataRecords.length;
        }

        // 删除单条记录
        function deleteRecord(index) {
            dataRecords.splice(index, 1);
            updateTable();
            
            if (dataRecords.length < 2) {
                generateBtn.disabled = true;
                drawLineBtn.disabled = true;
            }
            
            if (dataRecords.length === 0) {
                clearBtn.disabled = true;
            }
        }

        // 清空记录
        function clearRecords() {
            dataRecords = [];
            updateTable();
            clearBtn.disabled = true;
            generateBtn.disabled = true;
            drawLineBtn.disabled = true;
            chartGenerated = false;
            lineDrawn = false;
            clearChart();
        }

        // 生成图像
        function generateChart() {
            setupCanvas();
            const ctx = coordCanvas.getContext('2d');
            const width = coordCanvas.width;
            const height = coordCanvas.height;
            
            // 清空画布
            ctx.clearRect(0, 0, width, height);
            
            // 坐标系统设置
            const padding = { top: 30, right: 40, bottom: 50, left: 60 };
            const chartWidth = width - padding.left - padding.right;
            const chartHeight = height - padding.top - padding.bottom;
            
            // 坐标范围
            const maxArea = 350;
            const maxHeight = 50;
            
            // 绘制坐标轴
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 2;
            ctx.beginPath();
            // Y轴
            ctx.moveTo(padding.left, padding.top);
            ctx.lineTo(padding.left, height - padding.bottom);
            // X轴
            ctx.lineTo(width - padding.right, height - padding.bottom);
            ctx.stroke();
            
            // 绘制网格和刻度
            ctx.strokeStyle = '#e2e8f0';
            ctx.lineWidth = 1;
            ctx.fillStyle = '#64748b';
            ctx.font = '12px Arial';
            ctx.textAlign = 'center';
            
            // X轴刻度（底面积）
            for (let i = 0; i <= 350; i += 50) {
                const x = padding.left + (i / maxArea) * chartWidth;
                // 网格线
                ctx.beginPath();
                ctx.moveTo(x, padding.top);
                ctx.lineTo(x, height - padding.bottom);
                ctx.stroke();
                // 刻度标签
                ctx.fillText(i.toString(), x, height - padding.bottom + 20);
            }
            
            // Y轴刻度（高度）
            ctx.textAlign = 'right';
            for (let i = 0; i <= 50; i += 10) {
                const y = height - padding.bottom - (i / maxHeight) * chartHeight;
                // 网格线
                ctx.beginPath();
                ctx.moveTo(padding.left, y);
                ctx.lineTo(width - padding.right, y);
                ctx.stroke();
                // 刻度标签
                ctx.fillText(i.toString(), padding.left - 10, y + 4);
            }
            
            // 轴标签
            ctx.fillStyle = '#1e293b';
            ctx.font = 'bold 14px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('底面积 S (cm²)', width / 2, height - 10);
            
            ctx.save();
            ctx.translate(15, height / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.fillText('高度 h (cm)', 0, 0);
            ctx.restore();
            
            // 绘制数据点
            chartGenerated = true;
            lineDrawn = false;
            drawLineBtn.disabled = false;
            
            dataRecords.forEach((record, index) => {
                const x = padding.left + (record.area / maxArea) * chartWidth;
                const y = height - padding.bottom - (record.height / maxHeight) * chartHeight;
                
                // 绘制点
                ctx.beginPath();
                ctx.arc(x, y, 8, 0, Math.PI * 2);
                ctx.fillStyle = '#3b82f6';
                ctx.fill();
                ctx.strokeStyle = '#1e40af';
                ctx.lineWidth = 2;
                ctx.stroke();
                
                // 点标签
                ctx.fillStyle = '#1e293b';
                ctx.font = 'bold 12px Arial';
                ctx.textAlign = 'center';
                ctx.fillText(`(${record.area}, ${record.height})`, x, y - 15);
                
                // 编号
                ctx.fillStyle = 'white';
                ctx.fillText((index + 1).toString(), x, y + 4);
            });
            
            discoveryText.innerHTML = `已描出 <span class="font-bold text-blue-600">${dataRecords.length}</span> 个数据点！点击"连线"查看反比例曲线。`;
        }

        // 绘制连线
        function drawLine() {
            if (!chartGenerated || dataRecords.length < 2) {
                alert('请先生成图像！');
                return;
            }
            
            setupCanvas();
            const ctx = coordCanvas.getContext('2d');
            const width = coordCanvas.width;
            const height = coordCanvas.height;
            
            // 先重新绘制坐标系和点
            const padding = { top: 30, right: 40, bottom: 50, left: 60 };
            const chartWidth = width - padding.left - padding.right;
            const chartHeight = height - padding.top - padding.bottom;
            const maxArea = 350;
            const maxHeight = 50;
            
            // 重新绘制坐标系
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(padding.left, padding.top);
            ctx.lineTo(padding.left, height - padding.bottom);
            ctx.lineTo(width - padding.right, height - padding.bottom);
            ctx.stroke();
            
            // 网格
            ctx.strokeStyle = '#e2e8f0';
            ctx.lineWidth = 1;
            ctx.fillStyle = '#64748b';
            ctx.font = '12px Arial';
            ctx.textAlign = 'center';
            
            for (let i = 0; i <= 350; i += 50) {
                const x = padding.left + (i / maxArea) * chartWidth;
                ctx.beginPath();
                ctx.moveTo(x, padding.top);
                ctx.lineTo(x, height - padding.bottom);
                ctx.stroke();
                ctx.fillText(i.toString(), x, height - padding.bottom + 20);
            }
            
            ctx.textAlign = 'right';
            for (let i = 0; i <= 50; i += 10) {
                const y = height - padding.bottom - (i / maxHeight) * chartHeight;
                ctx.beginPath();
                ctx.moveTo(padding.left, y);
                ctx.lineTo(width - padding.right, y);
                ctx.stroke();
                ctx.fillText(i.toString(), padding.left - 10, y + 4);
            }
            
            // 轴标签
            ctx.fillStyle = '#1e293b';
            ctx.font = 'bold 14px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('底面积 S (cm²)', width / 2, height - 10);
            
            ctx.save();
            ctx.translate(15, height / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.fillText('高度 h (cm)', 0, 0);
            ctx.restore();
            
            // 绘制反比例曲线（平滑曲线）
            ctx.beginPath();
            ctx.strokeStyle = '#ef4444';
            ctx.lineWidth = 3;
            
            const points = [];
            for (let s = 5; s <= 350; s += 2) {
                const h = 1000 / s;
                if (h <= 50) {
                    const x = padding.left + (s / maxArea) * chartWidth;
                    const y = height - padding.bottom - (h / maxHeight) * chartHeight;
                    points.push({ x, y });
                }
            }
            
            // 绘制平滑曲线
            if (points.length > 0) {
                ctx.moveTo(points[0].x, points[0].y);
                for (let i = 1; i < points.length; i++) {
                    ctx.lineTo(points[i].x, points[i].y);
                }
                ctx.stroke();
            }
            
            // 高亮记录的点
            dataRecords.forEach((record, index) => {
                const x = padding.left + (record.area / maxArea) * chartWidth;
                const y = height - padding.bottom - (record.height / maxHeight) * chartHeight;
                
                ctx.beginPath();
                ctx.arc(x, y, 10, 0, Math.PI * 2);
                ctx.fillStyle = '#10b981';
                ctx.fill();
                ctx.strokeStyle = '#059669';
                ctx.lineWidth = 3;
                ctx.stroke();
                
                ctx.fillStyle = 'white';
                ctx.font = 'bold 12px Arial';
                ctx.textAlign = 'center';
                ctx.fillText((index + 1).toString(), x, y + 4);
            });
            
            lineDrawn = true;
            clearChartBtn.disabled = false;
            
            discoveryText.innerHTML = `<span class="text-red-600 font-bold">红色曲线</span>就是反比例函数 y = 1000/x 的图像！可以看到底面积越大，高度越小。`;
        }

        // 清空图像
        function clearChart() {
            const ctx = coordCanvas.getContext('2d');
            ctx.clearRect(0, 0, coordCanvas.width, coordCanvas.height);
            chartGenerated = false;
            lineDrawn = false;
            drawLineBtn.disabled = true;
            clearChartBtn.disabled = true;
            
            if (dataRecords.length >= 2) {
                generateBtn.disabled = false;
            }
            
            discoveryText.textContent = '图像已清空，可以重新生成或调整数据。';
        }

        // 初始化
        init();
    </script>

</body></html>
